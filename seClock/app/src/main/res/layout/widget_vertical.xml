<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="0dp">

    <TextClock
        android:id="@+id/clock_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:format12Hour="h"
        android:format24Hour="HH"
        android:gravity="center"
        android:textSize="64sp" />

    <TextClock
        android:id="@+id/clock_minute"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-18dp"
        android:fontFamily="sans-serif"
        android:format12Hour="mm"
        android:format24Hour="mm"
        android:gravity="center"
        android:textSize="64sp" />

    <TextClock
        android:id="@+id/clock_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-10dp"
        android:format12Hour="M月d日 EEE"
        android:format24Hour="M月d日 EEE"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/clock_alarm"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>
